                                    },
                                    { 
                                        name: "Aundh", lat: 18.5606, lng: 73.8120, density: "least",
                                        ageStats: { "0-10": 10, "11-20": 15, "21-30": 30, "31-40": 25, "41-50": 15, "50+": 5 }
                                    },
                                    { 
                                        name: "Shivaji Nagar", lat: 18.5308, lng: 73.8475, density: "dense",
                                        ageStats: { "0-10": 14, "11-20": 19, "21-30": 26, "31-40": 21, "41-50": 13, "50+": 7 }
