                                        ageStats: { "0-10": 15, "11-20": 19, "21-30": 25, "31-40": 21, "41-50": 13, "50+": 7 }
                                    },
                                    { 
                                        name: "Borivali", lat: 19.2183, lng: 72.8122, density: "moderate",
                                        ageStats: { "0-10": 16, "11-20": 20, "21-30": 24, "31-40": 20, "41-50": 12, "50+": 7 }
                                    },
                                    { 
                                        name: "Powai", lat: 19.1136, lng: 72.9091, density: "dense",
                                        ageStats: { "0-10": 10, "11-20": 15, "21-30": 33, "31-40": 25, "41-50": 12, "50+": 5 }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            "Karnataka": {
                center: [15.3173, 75.7139],
                districts: {
                    "Bangalore": {
                        center: [12.9716, 77.5946],
                        cities: {
                            "Bangalore City": {
                                center: [12.9716, 77.5946],
                                areas: [
                                    { 
                                        name: "MG Road", lat: 12.9716, lng: 77.5946, density: "dense",
                                        ageStats: { "0-10": 11, "11-20": 16, "21-30": 31, "31-40": 25, "41-50": 12, "50+": 5 }
                                    },
                                    { 
                                        name: "Koramangala", lat: 12.9352, lng: 77.6245, density: "moderate",
                                        ageStats: { "0-10": 9, "11-20": 13, "21-30": 34, "31-40": 27, "41-50": 12, "50+": 5 }
                                    },
                                    { 
                                        name: "Whitefield", lat: 12.9698, lng: 77.7500, density: "least",
                                        ageStats: { "0-10": 8, "11-20": 12, "21-30": 36, "31-40": 28, "41-50": 11, "50+": 5 }
                                    },
                                    { 
                                        name: "Jayanagar", lat: 12.9299, lng: 77.5833, density: "dense",
                                        ageStats: { "0-10": 13, "11-20": 17, "21-30": 28, "31-40": 23, "41-50": 13, "50+": 6 }
                                    },
                                    { 
                                        name: "Indiranagar", lat: 12.9784, lng: 77.6408, density: "moderate",
                                        ageStats: { "0-10": 10, "11-20": 15, "21-30": 32, "31-40": 26, "41-50": 12, "50+": 5 }
                                    },
                                    { 
                                        name: "HSR Layout", lat: 12.9352, lng: 77.6245, density: "moderate",
                                        ageStats: { "0-10": 12, "11-20": 16, "21-30": 30, "31-40": 24, "41-50": 12, "50+": 6 }
                                    },
                                    { 
                                        name: "BTM Layout", lat: 12.9161, lng: 77.6133, density: "moderate",
                                        ageStats: { "0-10": 11, "11-20": 14, "21-30": 32, "31-40": 26, "41-50": 12, "50+": 5 }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        };

        let map;
        let markers = [];

        function initMap() {
            map = L.map('map').setView([20.5937, 78.9629], 5);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(map);
        }

        function updateDistricts() {
            const state = document.getElementById('stateSelect').value;
            const districtSelect = document.getElementById('districtSelect');
            districtSelect.innerHTML = '<option value="">Select District</option>';
            if (state && data[state] && data[state].districts) {
                Object.keys(data[state].districts).forEach(district => {
                    const option = document.createElement('option');
                    option.value = district;
                    option.text = district;
                    districtSelect.appendChild(option);
                });
            }
            updateCities();
            updateMap();
        }

        function updateCities() {
            const state = document.getElementById('stateSelect').value;
            const district = document.getElementById('districtSelect').value;
            const citySelect = document.getElementById('citySelect');
            citySelect.innerHTML = '<option value="">Select City</option>';
            if (state && district && data[state].districts[district] && data[state].districts[district].cities) {
                Object.keys(data[state].districts[district].cities).forEach(city => {
                    const option = document.createElement('option');
                    option.value = city;
                    option.text = city;
                    citySelect.appendChild(option);
                });
            }
        }

        function updateMap() {
            const state = document.getElementById('stateSelect').value;
            const district = document.getElementById('districtSelect').value;
            const city = document.getElementById('citySelect').value;

            markers.forEach(marker => map.removeLayer(marker));
            markers = [];

            if (city && data[state] && data[state].districts[district] && data[state].districts[district].cities[city]) {
                const cityData = data[state].districts[district].cities[city];
                map.setView(cityData.center, 12);
                cityData.areas.forEach(area => {
                    addMarker(area);
                });
            } else if (district && data[state] && data[state].districts[district]) {
                const districtData = data[state].districts[district];
                map.setView(districtData.center, 10);
                Object.values(districtData.cities).forEach(cityData => {
                    cityData.areas.forEach(area => {
                        addMarker(area);
                    });
                });
            } else if (state && data[state]) {
                map.setView(data[state].center, 7);
            } else {
                map.setView([20.5937, 78.9629], 5);
            }
        }

        function addMarker(area) {
            let color = 'red';
            if (area.density === 'moderate') color = 'orange';
            else if (area.density === 'least') color = 'green';

            const marker = L.circleMarker([area.lat, area.lng], {
                color: color,
                fillColor: color,
                fillOpacity: 0.5,
                radius: 10,
                weight: 2
            }).addTo(map);

            // Add click event to show age-wise statistics
            marker.on('click', function() {
                showAgeStatistics(area);
            });

            markers.push(marker);
        }

        function showAgeStatistics(area) {
            const statsHtml = generateStatsHtml(area);
            const modal = document.getElementById('statsModal');
            document.getElementById('statsModalBody').innerHTML = statsHtml;
            modal.style.display = 'block';
        }

        function generateStatsHtml(area) {
            const stats = area.ageStats;
            const totalPopulation = Object.values(stats).reduce((a, b) => a + b, 0);

            let html = `
                <h5 class="mb-4">${area.name}</h5>
                <p class="text-muted">Density: <strong>${area.density}</strong></p>
                <h6 class="mt-4 mb-3">Age-wise Distribution (%)</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Age Group</th>
                                <th>Percentage</th>
                                <th>Visual</th>
                            </tr>
                        </thead>
                        <tbody>
            `;

            for (const [ageGroup, percentage] of Object.entries(stats)) {
                const color = getColorByPercentage(percentage);
                html += `
                    <tr>
                        <td><strong>${ageGroup} years</strong></td>
                        <td><span class="badge ${color}">${percentage}%</span></td>
                        <td>
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar ${getProgressBarColor(percentage)}" 
                                     role="progressbar" style="width: ${percentage}%" 
                                     aria-valuenow="${percentage}" aria-valuemin="0" aria-valuemax="100">
                                </div>
                            </div>
                        </td>
                    </tr>
                `;
            }

            html += `
                        </tbody>
                    </table>
                </div>
                <div class="alert alert-info mt-3" role="alert">
                    <strong>Total Population Base: 100%</strong>
                </div>
            `;

            return html;
        }

        function getColorByPercentage(percentage) {
            if (percentage >= 30) return 'badge-danger';
            if (percentage >= 20) return 'badge-warning';
            if (percentage >= 15) return 'badge-info';
            return 'badge-success';
        }

        function getProgressBarColor(percentage) {
            if (percentage >= 30) return 'bg-danger';
            if (percentage >= 20) return 'bg-warning';
            if (percentage >= 15) return 'bg-info';
            return 'bg-success';
        }

        function closeModal() {
            const modal = document.getElementById('statsModal');
            modal.style.display = 'none';
        }

        window.onclick = function(event) {
            const modal = document.getElementById('statsModal');
            if (event.target === modal) {
                modal.style.display = 'none';
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            initMap();
            document.getElementById('stateSelect').addEventListener('change', updateDistricts);
            document.getElementById('districtSelect').addEventListener('change', function() {
                updateCities();
                updateMap();
            });
            document.getElementById('citySelect').addEventListener('change', updateMap);
        });
    </script>
}
