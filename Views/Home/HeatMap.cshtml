                                        ageStats: { "0-10": 11, "11-20": 16, "21-30": 31, "31-40": 24, "41-50": 13, "50+": 5 }
                                    }
                                ]
                            }
                        }
                    },
                    "Mumbai": {
                        center: [19.0760, 72.8777],
                        cities: {
                            "Mumbai City": {
                                center: [19.0760, 72.8777],
                                areas: [
                                    { 
