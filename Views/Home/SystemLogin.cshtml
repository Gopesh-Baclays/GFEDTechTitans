@{
    ViewData["Title"] = "System Login";
    Layout = null;
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>System Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="~/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <style type="text/css">
        body {
            font-family: Calibri, Arial, sans-serif;
            font-size: 14px;
            color: #00AEEF;
            font-weight: normal;
            background: #f1f4f6;
            margin: 0;
            padding: 20px;
        }

        /* Outer wrapper that provides the visible border around the whole page content */
        .page-border {
            max-width: 1000px;
            margin: 20px auto;
            padding: 18px;
            border: 6px solid #00AEEF; /* page border color */
            border-radius: 14px;
            background: #ffffff; /* inner background so border is visible */
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

        .page-container {
            max-width: 960px;
            margin: 0 auto;
            padding: 12px;
        }

        /* Header (row 1) - image left, title/subtitle right horizontally */
        .sys-header {
            display: flex;
            align-items: center;
            gap: 20px;
            justify-content: center;
            margin-bottom: 10px;
        }
        .header-logo {
            width: 140px;
            height: 140px;
            object-fit: contain;
            border-radius: 8px;
            background: white;
            padding: 8px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.06);
        }
        .sys-title {
            text-align: left;
        }
        .sys-title h1 {
            font-size: 48px;
            margin: 0;
            color: #00AEEF;
            font-weight: 700;
        }
        .sys-title p {
            font-size: 20px;
            margin: 6px 0 0;
            color: #00AEEF;
            font-style: italic;
        }

        /* Pictures (row 2) */
        .icons-row {
            margin: 25px 0;
        }
        .icons-flex {
            display: flex;
            flex-wrap: nowrap;
            justify-content: center;
            align-items: center;
            gap: 2.5rem;
        }
        .icon-block {
            text-align: center;
            width: 260px;
        }
        .login_icons {
            width: 220px;
            height: 220px;
            object-fit: contain;
            display: block;
            margin: 0 auto;
            border-radius: 12px;
            background: white;
            padding: 12px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.06);
        }
        .icon-caption {
            text-align: center;
            margin-top: 12px;
            color: #6c757d;
            font-size: 14px;
            font-weight: 200;
        }

        /* Responsive adjustments */
       
        /* Login card (row 3) */
        .login-card {
            padding: 20px;
            border-radius: 12px;
            background: #ffffff;
            box-shadow: 0 6px 18px rgba(0,0,0,0.06);
        }
        .login-card .lead { color: #6c757d; }
        #btnLogin {
            background-color: #00AEEF;
            color: #fff;
            border: none;
        }
        #btnLogin:hover {
            background-color: #059bd1;
            color: #fff;
        }

        .vertical_blue_bar {
            width: 6px;
            height: 60px;
            background-color: #00AEEF;
            border-radius: 3px;
            margin: 0 auto 10px;
        }
    </style>
</head>
<body>
    <div class="page-border">
        <div class="page-container">
            <!-- ROW 1: Image OIP.png and Title + Subtitle horizontally -->
            <div class="row">
                <div class="col-12">
                    <div class="sys-header">
                        <img src="~/bootstrap/img/OIP.jpg" alt="AARAMBH Logo" class="header-logo" />
                        <div class="sys-title">
                            <h1>P.R.A.T.H.A.M.</h1>
                            <p>Patways for Readiness. Aptitude, Talent, Hiring, And Mentorship</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ROW 2: Pictures (large, horizontal alignment) -->
            <div class="row icons-row">
                <div class="col-12">
                    <div class="icons-flex">
                        <div class="icon-block">
                            <img src="~/bootstrap/img/Mission.png" alt="Mission" class="login_icons" />
                            <div class="lblLoginTitle">Mission</div>
                        </div>
                        <div class="icon-block">
                            <img src="~/bootstrap/img/Corevalues.png" alt="Core values" class="login_icons" />
                            <div class="lblLoginTitle">Core Values</div>
                        </div>
                        <div class="icon-block">
                            <img src="~/bootstrap/img/Vison.png" alt="Vision" class="login_icons" />
                            <div class="lblLoginTitle">Vision</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ROW 3: Login section -->
            <div class="row justify-content-center">
                <div class="col-12 col-md-8">
                    <div class="login-card">
                        <h3 id="lblLoginTitle">Login</h3>
                        <p class="lead" id="lblLoginSummary">Please log into the system</p>

                        <form id="form1" method="post" asp-action="SsoLogin">
                            <div class="text-center mb-3" id="lblLoginGuidance">
                                Click on the Login button below to log into the RECAP system using SSO
                            </div>

                            <div class="d-flex justify-content-center mb-2">
                                <button id="btnLogin" type="submit" class="btn btn-lg">SSO Login</button>
                            </div>

                            <div class="text-center text-muted" id="lblNewUserGuidance">
                                If you are not yet registered to use the system then please consult your system administrator.
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Side info box -->
                <div class="col-12 col-md-4 mt-3 mt-md-0">
                    <div class="login-card">
                        <div id="lblMisuseWarningHeading">Important</div>
                        <div id="lblMisuseWarningText">
                            Use of this system is authorised for assigned personnel only. Misuse will be reported.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/bootstrap/vendor/jquery/jquery.min.js"></script>
    <script src="~/bootstrap/js/bootstrap.bundle.min.js"></script>

    <script type="text/javascript">
        var btn = document.getElementById("btnLogin");
        if (btn) {
            btn.addEventListener("click", function (event) {
                // Keep default form submit to the SSO action
            });
        }
    </script>
</body>
</html>