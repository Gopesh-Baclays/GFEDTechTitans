@{
    ViewData["Title"] = "Engagement Engine";
    Layout = "_Layout";
}

@model RECAP.Models.EngagementViewModel

<style>
    .chatbot-container {
        display: flex;
        flex-direction: column;
        height: 500px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #f9f9f9;
        overflow: hidden;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 15px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .chat-message {
        display: flex;
        margin-bottom: 10px;
        animation: fadeIn 0.3s ease-in;
    }

   /*  keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    } */

    .chat-message.user {
        justify-content: flex-end;
    }

    .chat-bubble {
        max-width: 70%;
        padding: 10px 15px;
        border-radius: 12px;
        word-wrap: break-word;
    }

    .chat-message.user .chat-bubble {
        background-color: #007bff;
        color: white;
        border-bottom-right-radius: 4px;
    }

    .chat-message.bot .chat-bubble {
        background-color: #e9ecef;
        color: #333;
        border-bottom-left-radius: 4px;
        border: 1px solid #ddd;
    }

    .chat-sender {
        font-size: 0.85rem;
        color: #666;
        margin-bottom: 4px;
    }

    .chat-input-area {
        padding: 12px;
        border-top: 1px solid #ddd;
        display: flex;
        gap: 8px;
        background-color: white;
    }

    .chat-input-area input {
        flex: 1;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 8px 12px;
        font-size: 0.9rem;
    }

    .chat-input-area button {
        padding: 8px 16px;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.9rem;
    }

    .chat-input-area button:hover {
        background-color: #0056b3;
    }

    .chat-suggestions {
        padding: 10px;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        border-top: 1px solid #ddd;
    }

    .suggestion-btn {
        padding: 6px 12px;
        background-color: #f0f0f0;
        border: 1px solid #ddd;
        border-radius: 20px;
        cursor: pointer;        
        font-size: 0.85rem;
        transition: all 0.3s;
    }

    .suggestion-btn:hover {
        background-color: #e0e0e0;
        border-color: #007bff;
    }
</style>

<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Engagement Engine</h1>
    </div>

    <!-- Stage Selection & Predictability Score -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Select Engagement Stage</h6>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label for="stageSelect">Stage:</label>
                        <select class="form-control form-control-lg" id="stageSelect">
                            <option value="Identification">Identification</option>
                            <option value="Screening">Screening</option>
                            <option value="Counseling">Counseling</option>
                            <option value="Document Processing">Document Processing</option>
                            <option value="Waiting for Batch">Waiting for Batch</option>
                            <option value="On Job">On Job</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Predictability Score</h6>
                </div>
                <div class="card-body text-center">
                    <div class="h2 mb-0 font-weight-bold">
                        <span class="text-success">@Model.PredictabilityScore%</span>
                    </div>
                    <small class="text-muted d-block mt-2">Prospect Success Probability</small>
                    <div class="progress mt-3">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @Model.PredictabilityScore%"
                             aria-valuenow="@((int)Model.PredictabilityScore)" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Engagement Sections & Chatbot -->
    <div class="row">
        <!-- Left: Engagement Cards (3 columns) -->
        <div class="col-lg-8">
            <div class="row">
                <!-- Prospect Engagement Section -->
                <div class="col-md-4 mb-4">
                    <div class="card shadow h-100">
                        <div class="card-header py-3 bg-primary">
                            <h6 class="m-0 font-weight-bold text-white">
                                <i class="fas fa-user-graduate"></i> Prospect
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="small font-weight-bold text-uppercase mb-1">Name</label>
                                <p class="form-control-plaintext h6">@Model.ProspectName</p>
                            </div>
                            <div class="mb-3">
                                <label class="small font-weight-bold text-uppercase mb-1">Phone</label>
                                <p class="form-control-plaintext h6">
                                    <a href="tel:@Model.ProspectPhoneNumber">@Model.ProspectPhoneNumber</a>
                                </p>
                            </div>
                            <hr />
                            <div class="btn-group-vertical w-100" role="group">
                                <button type="button" class="btn btn-outline-success text-left mb-2 engagement-btn" 
                                        data-party="Prospect" data-channel="whatsapp" data-phone="@Model.ProspectPhoneNumber" data-name="@Model.ProspectName">
                                    <i class="fab fa-whatsapp"></i> WhatsApp
                                </button>
                                <button type="button" class="btn btn-outline-primary text-left mb-2 engagement-btn"
                                        data-party="Prospect" data-channel="socialmedia" data-phone="@Model.ProspectPhoneNumber" data-name="@Model.ProspectName">
                                    <i class="fab fa-facebook"></i> Social Media
                                </button>
                                <button type="button" class="btn btn-outline-info text-left engagement-btn"
                                        data-party="Prospect" data-channel="message" data-phone="@Model.ProspectPhoneNumber" data-name="@Model.ProspectName">
                                    <i class="fas fa-sms"></i> Message
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Guardian Engagement Section -->
                <div class="col-md-4 mb-4">
                    <div class="card shadow h-100">
                        <div class="card-header py-3 bg-warning">
                            <h6 class="m-0 font-weight-bold text-white">
                                <i class="fas fa-user-tie"></i> Guardian
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="small font-weight-bold text-uppercase mb-1">Name</label>
                                <p class="form-control-plaintext h6">@Model.GuardianName</p>
                            </div>
                            <div class="mb-3">
                                <label class="small font-weight-bold text-uppercase mb-1">Phone</label>
                                <p class="form-control-plaintext h6">
                                    <a href="tel:@Model.GuardianPhoneNumber">@Model.GuardianPhoneNumber</a>
                                </p>
                            </div>
                            <hr />
                            <div class="btn-group-vertical w-100" role="group">
                                <button type="button" class="btn btn-outline-success text-left mb-2 engagement-btn"
                                        data-party="Guardian" data-channel="whatsapp" data-phone="@Model.GuardianPhoneNumber" data-name="@Model.GuardianName">
                                    <i class="fab fa-whatsapp"></i> WhatsApp
                                </button>
                                <button type="button" class="btn btn-outline-primary text-left mb-2 engagement-btn"
                                        data-party="Guardian" data-channel="socialmedia" data-phone="@Model.GuardianPhoneNumber" data-name="@Model.GuardianName">
                                    <i class="fab fa-facebook"></i> Social Media
                                </button>
                                <button type="button" class="btn btn-outline-info text-left engagement-btn"
                                        data-party="Guardian" data-channel="message" data-phone="@Model.GuardianPhoneNumber" data-name="@Model.GuardianName">
                                    <i class="fas fa-sms"></i> Message
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Referee Engagement Section -->
                <div class="col-md-4 mb-4">
                    <div class="card shadow h-100">
                        <div class="card-header py-3 bg-info">
                            <h6 class="m-0 font-weight-bold text-white">
                                <i class="fas fa-user-check"></i> Referee
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="small font-weight-bold text-uppercase mb-1">Name</label>
                                <p class="form-control-plaintext h6">@Model.RefereeName</p>
                            </div>
                            <div class="mb-3">
                                <label class="small font-weight-bold text-uppercase mb-1">Phone</label>
                                <p class="form-control-plaintext h6">
                                    <a href="tel:@Model.RefereePhoneNumber">@Model.RefereePhoneNumber</a>
                                </p>
                            </div>
                            <hr />
                            <div class="btn-group-vertical w-100" role="group">
                                <button type="button" class="btn btn-outline-success text-left mb-2 engagement-btn"
                                        data-party="Referee" data-channel="whatsapp" data-phone="@Model.RefereePhoneNumber" data-name="@Model.RefereeName">
                                    <i class="fab fa-whatsapp"></i> WhatsApp
                                </button>
                                <button type="button" class="btn btn-outline-primary text-left mb-2 engagement-btn"
                                        data-party="Referee" data-channel="socialmedia" data-phone="@Model.RefereePhoneNumber" data-name="@Model.RefereeName">
                                    <i class="fab fa-facebook"></i> Social Media
                                </button>
                                <button type="button" class="btn btn-outline-info text-left engagement-btn"
                                        data-party="Referee" data-channel="message" data-phone="@Model.RefereePhoneNumber" data-name="@Model.RefereeName">
                                    <i class="fas fa-sms"></i> Message
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Chatbot Panel (4 columns) -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow h-100">
                <div class="card-header py-3 bg-success">
                    <h6 class="m-0 font-weight-bold text-white">
                        <i class="fas fa-comments"></i> PRATHAM Assistant
                    </h6>
                </div>
                <div class="card-body p-0" style="display: flex; flex-direction: column;">
                    <!-- Chat Messages -->
                    <div class="chat-messages" id="chatMessages">
                        <div class="chat-message bot">
                            <div>
                                <div class="chat-sender">PRATHAM Bot</div>
                                <div class="chat-bubble">
                                    👋 Hello! I'm your PRATHAM Assistant. How can I help you engage with prospects today?
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Chat Suggestions -->
                    <div class="chat-suggestions">
                        <button class="suggestion-btn" onclick="suggestMessage('Schedule a follow-up')">
                            📅 Schedule Follow-up
                        </button>
                        <button class="suggestion-btn" onclick="suggestMessage('Send a reminder')">
                            🔔 Send Reminder
                        </button>
                    </div>

                    <!-- Chat Input -->
                    <div class="chat-input-area">
                        <input type="text" id="chatInput" placeholder="Type your message..." />
                        <button onclick="sendChatMessage()">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Engagement History -->
    <div class="row mt-4">
        <div class="col-lg-12">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Engagement History</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="engagementHistoryTable" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Date & Time</th>
                                    <th>Party</th>
                                    <th>Channel</th>
                                    <th>Stage</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>2024-01-29 10:30 AM</td>
                                    <td>Prospect</td>
                                    <td>WhatsApp</td>
                                    <td>Identification</td>
                                    <td><span class="badge badge-success">Sent</span></td>
                                </tr>
                                <tr>
                                    <td>2024-01-28 02:15 PM</td>
                                    <td>Guardian</td>
                                    <td>Message</td>
                                    <td>Screening</td>
                                    <td><span class="badge badge-success">Sent</span></td>
                                </tr>
                                <tr>
                                    <td>2024-01-27 09:45 AM</td>
                                    <td>Referee</td>
                                    <td>Social Media</td>
                                    <td>Identification</td>
                                    <td><span class="badge badge-warning">Pending</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<a class="scroll-to-top rounded" href="#page-top">
    <i class="fas fa-angle-up"></i>
</a>

@section Scripts {
    <script>
        const prospectId = @Model.ProspectId;

        // Send chat message
        function sendChatMessage() {
            const input = document.getElementById('chatInput');
            const message = input.value.trim();

            if (!message) return;

            // Add user message to chat
            addChatMessage(message, 'user', 'You');
            input.value = '';

            // Send to server
            fetch('/Engagement/SendChatMessage', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    prospectId: prospectId,
                    partyType: 'Prospect',
                    message: message,
                    channel: 'message'
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    addChatMessage(data.message, 'bot', 'AARAMBH Bot');
                } else {
                    addChatMessage('Sorry, I encountered an error. Please try again.', 'bot', 'AARAMBH Bot');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                addChatMessage('Connection error. Please try again.', 'bot', 'AARAMBH Bot');
            });
        }

        function suggestMessage(suggestion) {
            const input = document.getElementById('chatInput');
            input.value = suggestion;
            input.focus();
        }

        function addChatMessage(message, type, sender) {
            const chatMessages = document.getElementById('chatMessages');
            const messageDiv = document.createElement('div');
            messageDiv.className = `chat-message ${type}`;
            messageDiv.innerHTML = `
                <div>
                    <div class="chat-sender">${sender}</div>
                    <div class="chat-bubble">${message}</div>
                </div>
            `;
            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        // Handle engagement buttons
        document.querySelectorAll('.engagement-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const party = this.dataset.party;
                const channel = this.dataset.channel;
                const name = this.dataset.name;

                addChatMessage(`Send ${channel} to ${party}`, 'user', 'You');
                setTimeout(() => {
                    addChatMessage(`I'll prepare a ${channel} message for ${name}. What would you like to say?`, 'bot', 'AARAMBH Bot');
                }, 500);
            });
        });

        // Allow Enter key to send message
        document.getElementById('chatInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                sendChatMessage();
            }
        });
    </script>
}