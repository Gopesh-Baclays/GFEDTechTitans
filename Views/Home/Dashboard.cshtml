@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<!-- #region Data Setup -->
@{
    var pieChartData = ViewBag.PieChartData ?? new int[] { 0, 0, 0 };
    var prospectStageLabels = ViewBag.ProspectStageLabels ?? new[] { "Identification", "Counselling", "Follow-ups", "Document Processing", "Waiting for Session" };
    var prospectStageDays = ViewBag.ProspectStageDays ?? new int[] { 5, 10, 15, 20, 8 };

    var prospectStageStuckLabels = ViewBag.ProspectStageLabels ?? new[] { "Identification", "Counselling", "Follow-ups", "Document Processing", "Waiting for Session" };
    var prospectStageStuckDays = ViewBag.ProspectStageDays ?? new int[] { 3, 5, 7, 4, 2 };

    var barLabels = ViewBag.BarLabels ?? new[] { "January", "February", "March", "April", "May", "June" };
    var matchedBalanceRuleBasedData = ViewBag.MatchedBalanceRuleBasedData ?? new decimal[] { 0, 0, 0, 0, 0, 0 };
    var matchedBalanceAiData = ViewBag.MatchedBalanceAiData ?? new decimal[] { 0, 0, 0, 0, 0, 0 };
    var unmatchedBalanceData = ViewBag.UnmatchedBalanceData ?? new decimal[] { 0, 0, 0, 0, 0, 0 };

    var yAxisMax = ViewBag.YAxisMax ?? 380000;
}

<script>
    var pieChartData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pieChartData));
    var prospectStageLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(prospectStageLabels));
    var prospectStageDays = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(prospectStageDays));

      var prospectStageStuckLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(prospectStageStuckLabels));
    var prospectStageStuckDays = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(prospectStageStuckDays));

    var barLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(barLabels));
    var matchedBalanceRuleBasedData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(matchedBalanceRuleBasedData));
    var matchedBalanceAiData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(matchedBalanceAiData));
    var unmatchedBalanceData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(unmatchedBalanceData));
    var yAxisMax = @yAxisMax;
</script>
<!-- #endregion -->

<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Dashboard</h1>
        <a href="javascript:void(0);" onclick="runReconn()" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-play fa-sm text-white-50"></i> Refresh Dashboard
        </a>
    </div>

    <!-- Content Row - Summary Cards -->
    <div class="row">
        <!-- Total Students Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <a href="@Url.Action("DataFetch", "Home")" class="text-decoration-none">
                <div class="card border-left-primary shadow h-100 py-2">
                    <div class="card-body position-relative">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                    Total Students
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    @ViewBag.TotalAmount
                                </div>
                                <span class="stretched-link"></span>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-users fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Fully Onboarded Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <a href="@Url.Action("DataFetch", "Home")" class="text-decoration-none">
                <div class="card border-left-success shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                    Fully Onboarded
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    @ViewBag.MatchedBalanceRuleBased
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- In Progress Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <a href="@Url.Action("DataFetch", "Home")" class="text-decoration-none">
                <div class="card border-left-info shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                    In Progress
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    @ViewBag.MatchedBalanceAi
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-hourglass-half fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Pending Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <a href="@Url.Action("DataFetch", "Home")" class="text-decoration-none">
                <div class="card border-left-warning shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                    Drop Outs
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    @ViewBag.UnmatchedBalance
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-clock fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Charts Row 1 -->
    <div class="row">
        <!-- Bar Chart -->
        @*  <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Monthly Distribution</h6>
                </div>
                <div class="card-body">
                    <div class="chart-bar">
                        <canvas id="myBarChart"></canvas>
                    </div>
                </div>
            </div>
        </div> *@

        <!-- Prospect Stage Pie Chart -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Prospect Stage Distribution (Days)</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie pt-4 pb-2">
                        <canvas id="prospectStagePieChart"></canvas>
                    </div>
                    <hr />
                    <small class="text-muted d-block mt-2">Time spent in each stage of the prospect journey</small>
                </div>
            </div>
        </div>

        <!-- Matching Overview Pie Chart -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Predictability Score</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie pt-4 pb-2">
                        <canvas id="myPieChart"></canvas>
                    </div>
                    <hr />
                    <small class="text-muted d-block mt-2">Predictability score for In Progress cases</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 2 - Prospect Stage Distribution -->
    <div class="row">
        <!-- 15 Days Cases -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">15 Days (No Status Change)</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie pt-4 pb-2">
                        <canvas id="15DaysNoStatusChange"></canvas>
                    </div>
                    <hr />
                    <small class="text-muted d-block mt-2">Need  attention: All the cases for which Current status is not being chnaged for 15 days</small>
                </div>
            </div>
        </div>

        <!-- Rule Based Matching Card -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Dropout Top Reasons</h6>
                </div>
                <div class="card-body">
                    <h4 class="small font-weight-bold">Sickness <span class="float-right">38%</span></h4>
                    <div class="progress mb-4">
                        <div class="progress-bar bg-danger" role="progressbar" style="width: 38%"
                             aria-valuenow="38" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <h4 class="small font-weight-bold">High wait time <span class="float-right">29%</span></h4>
                    <div class="progress mb-4">
                        <div class="progress-bar bg-warning" role="progressbar" style="width: 29%"
                             aria-valuenow="29" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <h4 class="small font-weight-bold">Center too far <span class="float-right">13%</span></h4>
                    <div class="progress mb-4">
                        <div class="progress-bar bg-info" role="progressbar" style="width: 13%"
                             aria-valuenow="13" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>

                    <h4 class="small font-weight-bold">Low Trust <span class="float-right">11%</span></h4>
                    <div class="progress mb-4">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: 11%"
                             aria-valuenow="11" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <h4 class="small font-weight-bold">Got Another Opportunity <span class="float-right">9%</span></h4>
                    <div class="progress mb-4">
                        <div class="progress-ba bg-dark" role="progressbar" style="width: 9%"
                             aria-valuenow="9" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <hr />
                    <small class="text-muted d-block mt-2">Top 5 reason why prspects dropped/opted out</small>

                </div>
            </div>
        </div>
    </div>
</div>

<a class="scroll-to-top rounded" href="#page-top">
    <i class="fas fa-angle-up"></i>
</a>

@section Scripts {
    <script src="~/bootstrap/vendor/chart.js/Chart.min.js"></script>
    <script src="~/bootstrap/js/demo/chart-area-demo.js"></script>
    <script src="~/bootstrap/js/demo/chart-pie-demo.js"></script>
    <script src="~/bootstrap/js/demo/chart-bar-demo.js"></script>

    <script>
        // Prospect Stage Distribution Pie Chart
        var ctxProspectStage = document.getElementById("prospectStagePieChart");
        if (ctxProspectStage) {
            var prospectStageChart = new Chart(ctxProspectStage, {
                type: 'doughnut',
                data: {
                    labels: prospectStageLabels,
                    datasets: [{
                        data: prospectStageDays,
                        backgroundColor: [
                            '#4e73df',
                            '#858ae3',
                            '#36b9cc',
                            '#1cc88a',
                            '#f6c23e'
                        ],
                        borderColor: '#ffffff',
                        borderWidth: 2
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    tooltips: {
                        backgroundColor: "rgb(255,255,255)",
                        bodyFontColor: "#858796",
                        borderColor: '#dddfaa',
                        borderWidth: 1,
                        xPadding: 15,
                        yPadding: 15,
                        displayColors: false,
                        caretPadding: 10,
                        // callbacks: {
                        //     label: function(tooltipItem, chart) {
                        //         var dataset = chart.datasets[0];
                        //         var total = dataset.data.reduce(function(previousValue, currentValue) {
                        //             return previousValue + currentValue;
                        //         });
                        //         var percentages = Math.round((tooltipItem.value / total) * 100);
                        //         return tooltipItem.label + ': ' + tooltipItem.value + ' days (' + percentages + '%)';
                        //     }
                        // }
                    },
                    responsive: true,
                    legend: {
                        display: true,
                        position: 'bottom'
                    },
                    cutoutPercentage: 80
                }
            });
        }

        // Prospect Stage Distribution/Stuck Pie Chart
        var ctxProspectStage = document.getElementById("15DaysNoStatusChange");
        if (ctxProspectStage) {
            var prospectStageChart = new Chart(ctxProspectStage, {
                type: 'doughnut',
                data: {
                    labels: prospectStageStuckLabels,
                    datasets: [{
                        data: prospectStageStuckDays,
                        backgroundColor: [
                            '#4e73df',
                            '#858ae3',
                            '#36b9cc',
                            '#1cc88a',
                            '#f6c23e'
                        ],
                        borderColor: '#ffffff',
                        borderWidth: 2
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    tooltips: {
                        backgroundColor: "rgb(255,255,255)",
                        bodyFontColor: "#858796",
                        borderColor: '#dddfaa',
                        borderWidth: 1,
                        xPadding: 15,
                        yPadding: 15,
                        displayColors: false,
                        caretPadding: 10,
                        // callbacks: {
                        //     label: function(tooltipItem, chart) {
                        //         var dataset = chart.datasets[0];
                        //         var total = dataset.data.reduce(function(previousValue, currentValue) {
                        //             return previousValue + currentValue;
                        //         });
                        //         var percentages = Math.round((tooltipItem.value / total) * 100);
                        //         return tooltipItem.label + ': ' + tooltipItem.value + ' days (' + percentages + '%)';
                        //     }
                        // }
                    },
                    responsive: true,
                    legend: {
                        display: true,
                        position: 'bottom'
                    },
                    cutoutPercentage: 80
                }
            });
        }

        // Refresh Dashboard
        function runReconn() {
            fetch('@Url.Action("RunPythonScript", "Home")', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Dashboard refreshed!');
                    location.reload();
                } else {
                    alert('Failed to refresh dashboard.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error refreshing dashboard.');
            });
        }
    </script>
}